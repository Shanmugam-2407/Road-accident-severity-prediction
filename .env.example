# RoadGuard AI Configuration

# API Configuration
API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000

# Dataset Paths
DATASET_PATH=data/sample/sample_accidents.csv
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Model Artifacts & Reports
MODEL_ARTIFACT_PATH=artifacts/accident_severity_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json
EVALUATION_SUMMARY_PATH=reports/evaluation_summary.json
MODEL_COMPARISON_PATH=reports/model_comparison.csv

# File Upload Limit (MB)
MAX_UPLOAD_SIZE_MB=25

# Environment
APP_ENV=development

